			<button type="button" class="lightbox-close" id="lightboxClose" aria-label="Fechar">×</button>
			<button type="button" class="gallery-nav gallery-prev" id="lightboxPrev" aria-label="Foto anterior"><span class="gallery-nav-arrow"></span></button>
			<img class="lightbox-img" id="lightboxImg" src="" alt="" />
			<button type="button" class="gallery-nav gallery-next" id="lightboxNext" aria-label="Próxima foto"><span class="gallery-nav-arrow"></span></button>
			<span class="lightbox-count" id="lightboxCount"></span>
		</div>

		<script define:vars={{ quotes, playlist }}>
			(function () {
				let idx = 0;
				const card = document.getElementById("epigraphCard");
				const textEl = document.getElementById("epigraphText");
				const citeEl = document.getElementById("epigraphCite");

				function showQuote(i) {
					textEl.classList.add("is-turning");
					window.setTimeout(function () {
						textEl.textContent = '"' + quotes[i].text + '"';
						citeEl.textContent = "— " + quotes[i].cite;
						textEl.classList.remove("is-turning");
					}, 160);
				}

				card.addEventListener("click", function () {
					idx = (idx + 1) % quotes.length;
					showQuote(idx);
				});

				// links internos (âncoras) rolando suavemente até a seção
				document.querySelectorAll('a[href^="#"]').forEach(function (link) {
					link.addEventListener("click", function (event) {
						const targetId = link.getAttribute("href").slice(1);
						const target = document.getElementById(targetId);
						if (!target) return;
						event.preventDefault();
						target.scrollIntoView({ behavior: "smooth", block: "start" });
					});
				});

				// easter egg pro console, pra quem for dev o suficiente pra abrir o inspetor
				console.log(
					"%cvocê achou a página em branco.\n%cVol. IV ainda não foi escrito — talvez seja a próxima vaga.",
					"font-family: serif; font-style: italic; font-size: 13px; color: #A32C3B;",
					"font-family: monospace; font-size: 11px; color: inherit;"
				);

				// ---------- lightbox (tela cheia) ----------
				const lightbox = document.getElementById("lightbox");
				const lightboxImg = document.getElementById("lightboxImg");
				const lightboxPrev = document.getElementById("lightboxPrev");
				const lightboxNext = document.getElementById("lightboxNext");
				const lightboxClose = document.getElementById("lightboxClose");
				const lightboxCount = document.getElementById("lightboxCount");
				let activeGallery = null;

				function renderLightbox() {
					if (!activeGallery) return;
					const img = activeGallery.imgs[activeGallery.index];
					lightboxImg.src = img.src;
					lightboxImg.alt = img.alt;
					const multi = activeGallery.imgs.length > 1;
					lightboxPrev.style.display = multi ? "" : "none";
					lightboxNext.style.display = multi ? "" : "none";
					lightboxCount.style.display = multi ? "" : "none";
					lightboxCount.textContent = (activeGallery.index + 1) + " / " + activeGallery.imgs.length;
				}

				function openLightbox(state) {
					activeGallery = state;
					renderLightbox();
					lightbox.classList.add("is-open");
					document.body.style.overflow = "hidden";
					lightboxClose.focus();
				}

				function closeLightbox() {
					lightbox.classList.remove("is-open");
					document.body.style.overflow = "";
					activeGallery = null;
				}

				lightboxClose.addEventListener("click", closeLightbox);
				lightbox.addEventListener("click", function (event) {
					if (event.target === lightbox) closeLightbox();
				});
				document.addEventListener("keydown", function (event) {
					if (event.key === "Escape" && lightbox.classList.contains("is-open")) closeLightbox();
				});
				lightboxPrev.addEventListener("click", function () {
					if (!activeGallery) return;
					activeGallery.index = (activeGallery.index - 1 + activeGallery.imgs.length) % activeGallery.imgs.length;
					activeGallery.render();
					renderLightbox();
				});
				lightboxNext.addEventListener("click", function () {
					if (!activeGallery) return;
					activeGallery.index = (activeGallery.index + 1) % activeGallery.imgs.length;
					activeGallery.render();
					renderLightbox();
				});

				// galerias de print (reutilizável — cada .gallery no card se inicializa sozinha,
				// e clicar numa foto abre ela em tela cheia no lightbox acima)
				document.querySelectorAll(".gallery").forEach(function (gallery) {
					const imgs = Array.from(gallery.querySelectorAll(".gallery-img"));
					const prevBtn = gallery.querySelector(".gallery-prev");
					const nextBtn = gallery.querySelector(".gallery-next");
					const countEl = gallery.querySelector(".gallery-count");
					const state = { imgs: imgs, index: 0 };
					state.render = function () {
						imgs.forEach(function (img, i) { img.classList.toggle("is-active", i === state.index); });
						if (countEl) countEl.textContent = (state.index + 1) + " / " + imgs.length;
					};
					if (imgs.length <= 1) {
						if (prevBtn) prevBtn.style.display = "none";
						if (nextBtn) nextBtn.style.display = "none";
						if (countEl) countEl.style.display = "none";
					} else {
						prevBtn.addEventListener("click", function () {
							state.index = (state.index - 1 + imgs.length) % imgs.length;
							state.render();
						});
						nextBtn.addEventListener("click", function () {
							state.index = (state.index + 1) % imgs.length;
							state.render();
						});
					}
					imgs.forEach(function (img) {
						img.addEventListener("click", function () { openLightbox(state); });
					});
				});

				// ---------- disco: playlist real com nome, artista, capa e progresso ----------
				const widget = document.getElementById("vinylWidget");
				const btn = document.getElementById("vinylBtn");
				const audio = document.getElementById("vinylAudio");
				const coverEl = document.getElementById("vinylCover");
				const trackEl = document.getElementById("vinylTrack");
				const artistEl = document.getElementById("vinylArtist");
				const fillEl = document.getElementById("vinylProgressFill");
				const elapsedEl = document.getElementById("vinylElapsed");
				const durationEl = document.getElementById("vinylDuration");
				const volumeInput = document.getElementById("vinylVolume");
				const nextBtn = document.getElementById("vinylNext");
				let trackIndex = 0;

				function formatTime(seconds) {
					if (!isFinite(seconds)) return "0:00";
					const m = Math.floor(seconds / 60);
					const s = Math.floor(seconds % 60);
					return m + ":" + String(s).padStart(2, "0");
				}

				function loadTrack(i) {
					trackIndex = i;
					const track = playlist[trackIndex];
					audio.src = track.src;
					coverEl.src = track.cover;
					coverEl.alt = "Capa de " + track.title + " (" + track.artist + ")";
					trackEl.textContent = track.title;
					artistEl.textContent = track.artist;
					fillEl.style.width = "0%";
					elapsedEl.textContent = "0:00";
					durationEl.textContent = "0:00";
				}

				audio.addEventListener("loadedmetadata", function () {
					durationEl.textContent = formatTime(audio.duration);
				});
				audio.addEventListener("timeupdate", function () {
					if (audio.duration) {
						fillEl.style.width = (audio.currentTime / audio.duration) * 100 + "%";
					}
					elapsedEl.textContent = formatTime(audio.currentTime);
				});
				audio.addEventListener("ended", function () {
					loadTrack((trackIndex + 1) % playlist.length);
					audio.play();
				});

				audio.volume = 0.25;
				loadTrack(0);

				btn.addEventListener("click", function () {
					if (audio.paused) {
						audio.play();
					} else {
						audio.pause();
					}
				});
				nextBtn.addEventListener("click", function () {
					const wasPlaying = !audio.paused;
					loadTrack((trackIndex + 1) % playlist.length);
					if (wasPlaying) audio.play();
				});
				volumeInput.addEventListener("input", function () {
					audio.volume = parseFloat(volumeInput.value);
				});
				audio.addEventListener("play", function () {
					widget.setAttribute("data-playing", "true");
					btn.setAttribute("aria-pressed", "true");
					btn.setAttribute("aria-label", "Pausar trilha sonora");
				});
				audio.addEventListener("pause", function () {
					widget.setAttribute("data-playing", "false");
					btn.setAttribute("aria-pressed", "false");
					btn.setAttribute("aria-label", "Tocar trilha sonora");
				});
			})();
		</script>
	</body>
