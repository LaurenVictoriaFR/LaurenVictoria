---
const quotes = [
  { text: "Às estrelas que escutam, e aos sonhos que são respondidos.", cite: "Sarah J. Maas, série A Corte de Espinhos e Rosas" },
  { text: "O essencial é invisível aos olhos.", cite: "Antoine de Saint-Exupéry, O Pequeno Príncipe" },
  { text: "Quando certa manhã Gregor Samsa acordou de sonhos intranquilos, encontrou-se em sua cama metamorfoseado num inseto monstruoso.", cite: "Franz Kafka, A Metamorfose" },
  { text: "Que a sorte esteja sempre ao seu favor.", cite: "Suzanne Collins, Jogos Vorazes" },
  { text: "A inteligência é um dos maiores dons humanos, mas, na busca frenética pelo conhecimento, corre-se o risco de esquecer de amar quem está ao redor.", cite: "Daniel Keyes, Flores para Algernon" },
  { text: "Quando tiver que escolher entre estar certo e ser gentil, escolha ser gentil.", cite: "R. J. Palacio, Extraordinário" },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const playlist = [
  { title: "Dancing Queen", artist: "ABBA", src: `${base}/audio/dancing-queen.mp3`, cover: `${base}/images/covers/abba-arrival.webp` },
  { title: "Waiting for the End", artist: "Linkin Park", src: `${base}/audio/waiting-for-the-end.mp3`, cover: `${base}/images/covers/linkin-park-live.jpg` },
];
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Portfólio de Lauren Victoria — estudante de Ciência da Computação (UFS), backend Java." />
		<title>Lauren Victoria — Portfólio</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<style is:global>
			:root {
				--bg: #f4eae6;
				--surface: #fffcfa;
				--surface-raised: #ffffff;
				--ink: #201412;
				--ink-soft: #5e4642;
				--ink-faint: #93807b;
				--accent: #7c1f2c;
				--accent-bright: #a32c3b;
				--accent-ink: #fbedea;
				--line: #e4d1cb;
				--line-strong: #cfb2aa;
				--stamp: #16100f;
				--stamp-ink: #f4eae6;
			}

			@media (prefers-color-scheme: dark) {
				:root:not([data-theme="light"]) {
					--bg: #130d0d;
					--surface: #1b1213;
					--surface-raised: #211617;
					--ink: #f1e3de;
					--ink-soft: #c1a29b;
					--ink-faint: #78605c;
					--accent: #c6394a;
					--accent-bright: #e14b5c;
					--accent-ink: #150b0c;
					--line: #34201f;
					--line-strong: #4a2c2a;
					--stamp: #f1e3de;
					--stamp-ink: #130d0d;
				}
			}

			:root[data-theme="dark"] {
				--bg: #130d0d;
				--surface: #1b1213;
				--surface-raised: #211617;
				--ink: #f1e3de;
				--ink-soft: #c1a29b;
				--ink-faint: #78605c;
				--accent: #c6394a;
				--accent-bright: #e14b5c;
				--accent-ink: #150b0c;
				--line: #34201f;
				--line-strong: #4a2c2a;
				--stamp: #f1e3de;
				--stamp-ink: #130d0d;
			}

			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; }
			@media (prefers-reduced-motion: reduce) {
				html { scroll-behavior: auto; }
				* {
					animation-duration: 0.001ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.001ms !important;
				}
			}

			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
				font-size: 16px;
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
			}

			a { color: inherit; }

			.frame {
				display: grid;
				grid-template-columns: clamp(2.5rem, 5vw, 4.25rem) 1fr;
				max-width: 1180px;
				margin: 0 auto;
			}

			.gutter { border-right: 1px solid var(--line); }
			.gutter-track {
				position: sticky;
				top: 0;
				height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: space-between;
				padding: 1.75rem 0;
			}
			.gutter-marks {
				font-family: "IBM Plex Mono", monospace;
				font-size: 0.7rem;
				color: var(--ink-faint);
				writing-mode: vertical-rl;
				transform: rotate(180deg);
				letter-spacing: 0.08em;
			}

			main { min-width: 0; }
			.rail { padding: 0 clamp(1.25rem, 4vw, 3.5rem); }

			section {
				padding: clamp(3rem, 7vw, 5.5rem) 0;
				border-bottom: 1px solid var(--line);
			}
			section:last-of-type { border-bottom: none; }

			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-family: "IBM Plex Mono", monospace;
				font-size: 0.76rem;
				color: var(--accent);
				letter-spacing: 0.02em;
				margin: 0 0 1rem;
			}
			.eyebrow::before {
				content: "";
				width: 0.5rem;
				height: 0.5rem;
				background: var(--accent);
				border-radius: 1px;
				display: inline-block;
			}

			h1, h2, h3 {
				font-family: "Newsreader", ui-serif, Georgia, serif;
				font-weight: 500;
				text-wrap: balance;
				margin: 0;
			}

			/* ---------- Hero ---------- */
			.hero { padding-top: clamp(3.5rem, 9vw, 6.5rem); display: flex; flex-direction: column; gap: 1.5rem; }
			.hero h1 {
				font-size: clamp(2.6rem, 6vw, 4.4rem);
				line-height: 1.05;
				letter-spacing: -0.01em;
			}
			.hero h1 em { font-style: italic; color: var(--accent); }
			.hero-role { font-family: "IBM Plex Mono", monospace; font-size: clamp(0.95rem, 1.6vw, 1.1rem); color: var(--ink-soft); }
			.hero-role .cursor {
				display: inline-block; width: 0.55em; height: 1em; background: var(--accent);
				margin-left: 0.15em; vertical-align: text-bottom; animation: blink 1.1s steps(1) infinite;
			}
			@keyframes blink { 50% { opacity: 0; } }
			.hero-lede { max-width: 58ch; font-size: 1.05rem; color: var(--ink-soft); }
			.hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 0.5rem; }

			.btn {
				font-family: "IBM Plex Mono", monospace; font-size: 0.85rem; padding: 0.75rem 1.3rem;
				border-radius: 3px; text-decoration: none; border: 1px solid var(--line-strong);
				transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease, filter 0.15s ease;
				cursor: pointer;
			}
			.btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			.btn-primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.btn-primary:hover { filter: brightness(1.12); }
			.btn-ghost { color: var(--ink); background: transparent; }
			.btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

			.hero-meta {
				display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; margin-top: 1.5rem;
				font-family: "IBM Plex Mono", monospace; font-size: 0.78rem; color: var(--ink-faint);
			}
			.hero-meta span { white-space: nowrap; }

			/* ---------- Quote / epígrafe ---------- */
			.epigraph-section { padding: clamp(2.25rem, 5vw, 3rem) 0; }
			.epigraph-card {
				background: var(--surface-raised);
				border: 1px solid var(--line);
				border-left: 3px solid var(--accent);
				border-radius: 2px;
				padding: 1.75rem 2rem;
				cursor: pointer;
				max-width: 62ch;
				min-height: clamp(210px, 30vw, 250px);
				position: relative;
				transition: border-color 0.15s ease, transform 0.1s ease;
				font: inherit;
				color: inherit;
				text-align: left;
				display: flex;
				flex-direction: column;
				justify-content: flex-start;
			}
			@media (max-width: 720px) {
				.epigraph-card { min-height: 260px; }
			}
			.epigraph-card:hover { border-color: var(--line-strong); border-left-color: var(--accent-bright); }
			.epigraph-card:active { transform: translateY(1px); }
			.epigraph-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

			.epigraph-text {
				font-family: "Newsreader", serif;
				font-style: italic;
				font-size: clamp(1.15rem, 2.4vw, 1.45rem);
				line-height: 1.45;
				margin: 0 0 0.85rem;
				transition: opacity 0.18s ease;
			}
			.epigraph-text.is-turning { opacity: 0; }
			.epigraph-cite {
				font-family: "IBM Plex Mono", monospace;
				font-size: 0.78rem;
				color: var(--ink-faint);
			}
			.epigraph-hint {
				font-family: "IBM Plex Mono", monospace;
				font-size: 0.7rem;
				color: var(--ink-faint);
				margin-top: 1rem;
				letter-spacing: 0.02em;
			}

			/* ---------- About ---------- */
			.about-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
			@media (max-width: 720px) { .about-grid { grid-template-columns: 1fr; } }
			.about-text p { max-width: 60ch; color: var(--ink-soft); font-size: 1.02rem; }
			.about-text p + p { margin-top: 1rem; }
			.about-text strong { color: var(--ink); font-weight: 600; }

			.stack-card { background: var(--surface-raised); border: 1px solid var(--line); border-radius: 4px; padding: 1.5rem 1.6rem; }
			.stack-card h3 {
				font-size: 0.9rem; font-family: "IBM Plex Mono", monospace; color: var(--ink-faint);
				letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 500;
			}
			.stack-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
			.stack-list li {
				font-family: "IBM Plex Mono", monospace; font-size: 0.82rem; background: var(--bg);
				color: var(--ink); padding: 0.35rem 0.65rem; border-radius: 3px; border: 1px solid var(--line);
			}

			/* ---------- Estante (projects) ---------- */
			.section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 2.25rem; flex-wrap: wrap; }
			.section-head h2 { font-size: clamp(1.7rem, 3.2vw, 2.15rem); }
			.section-head .count { font-family: "IBM Plex Mono", monospace; font-size: 0.8rem; color: var(--ink-faint); }

			.projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }
			.card-stack { display: flex; flex-direction: column; gap: 1.25rem; }
			.card-stack .card { flex: 1; }
			.card {
				background: var(--surface-raised); border: 1px solid var(--line); border-radius: 5px;
				padding: 1.6rem; display: flex; flex-direction: column; gap: 0.9rem;
				transition: border-color 0.15s ease, transform 0.15s ease;
			}
			.card:hover { border-color: var(--accent); transform: translateY(-2px); }
			.card-vol { font-family: "IBM Plex Mono", monospace; font-size: 0.72rem; color: var(--accent); letter-spacing: 0.04em; }
			.card-path { font-family: "IBM Plex Mono", monospace; font-size: 0.7rem; color: var(--ink-faint); }
			.card h3 { font-size: 1.15rem; font-family: "Newsreader", serif; font-weight: 500; }
			.card p { color: var(--ink-soft); font-size: 0.92rem; margin: 0; flex-grow: 1; }
			.tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; }
			.tags li {
				font-family: "IBM Plex Mono", monospace; font-size: 0.72rem; color: var(--accent);
				background: color-mix(in srgb, var(--accent) 12%, transparent); padding: 0.22rem 0.55rem; border-radius: 2px;
			}
			.card-link {
				font-family: "IBM Plex Mono", monospace; font-size: 0.8rem; color: var(--ink); text-decoration: none;
				display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.2rem;
				border-bottom: 1px solid var(--line-strong); align-self: flex-start; padding-bottom: 0.1rem;
			}
			.card-link:hover { color: var(--accent); border-color: var(--accent); }
			.card-link.is-pending {
				color: var(--ink-faint);
				border-bottom-style: dashed;
				cursor: default;
			}
			.card-link.is-pending:hover { color: var(--ink-faint); border-color: var(--line-strong); }

			/* ---------- Galeria de prints ---------- */
			.gallery { position: relative; }
			.gallery-track {
				position: relative;
				width: 100%;
				aspect-ratio: 2 / 1;
				border-radius: 3px;
				overflow: hidden;
				border: 1px solid var(--line);
				background: var(--bg);
			}
			.gallery-img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: top;
				opacity: 0;
				transition: opacity 0.2s ease;
				cursor: zoom-in;
			}
			.gallery-img.is-active { opacity: 1; }

			.gallery-empty {
				width: 100%;
				aspect-ratio: 2 / 1;
				border-radius: 3px;
				border: 1px dashed var(--line-strong);
				display: flex;
				align-items: center;
				justify-content: center;
				font-family: "IBM Plex Mono", monospace;
				font-size: 0.72rem;
				color: var(--ink-faint);
				letter-spacing: 0.02em;
				text-align: center;
				padding: 1rem;
			}

			.gallery-nav {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				width: 1.8rem;
				height: 1.8rem;
				border-radius: 50%;
				border: none;
				background: hsl(0 0% 0% / 0.45);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: background 0.15s ease;
			}
			.gallery-nav:hover { background: hsl(0 0% 0% / 0.65); }
			.gallery-nav:focus-visible { outline: 2px solid var(--accent-bright); outline-offset: 2px; }
			.gallery-prev { left: 0.5rem; }
			.gallery-next { right: 0.5rem; }
			.gallery-nav-arrow { width: 0; height: 0; border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
			.gallery-prev .gallery-nav-arrow { border-right: 7px solid #fff; margin-right: 1px; }
			.gallery-next .gallery-nav-arrow { border-left: 7px solid #fff; margin-left: 1px; }

			.gallery-count {
				position: absolute;
				bottom: 0.5rem;
				right: 0.5rem;
				font-family: "IBM Plex Mono", monospace;
				font-size: 0.65rem;
				color: #fff;
				background: hsl(0 0% 0% / 0.45);
				padding: 0.15rem 0.45rem;
				border-radius: 2px;
				letter-spacing: 0.02em;
			}

			/* ---------- Lightbox (tela cheia) ---------- */
			.lightbox {
				position: fixed;
				inset: 0;
				z-index: 100;
				background: hsl(0 0% 0% / 0.88);
				display: none;
				align-items: center;
				justify-content: center;
				padding: clamp(1rem, 5vw, 4rem);
			}
			.lightbox.is-open { display: flex; }
			.lightbox-img {
				max-width: 100%;
				max-height: 100%;
				border-radius: 3px;
				box-shadow: 0 12px 40px hsl(0 0% 0% / 0.5);
			}
			.lightbox-close {
				position: absolute;
				top: clamp(0.75rem, 3vw, 1.5rem);
				right: clamp(0.75rem, 3vw, 1.5rem);
				width: 2.5rem;
				height: 2.5rem;
				border-radius: 50%;
				border: 1px solid hsl(0 0% 100% / 0.3);
				background: hsl(0 0% 0% / 0.4);
				cursor: pointer;
				color: #fff;
				font-family: "IBM Plex Mono", monospace;
				font-size: 1.1rem;
				line-height: 1;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.lightbox-close:hover { background: hsl(0 0% 0% / 0.65); }
			.lightbox-close:focus-visible { outline: 2px solid var(--accent-bright); outline-offset: 2px; }
			.lightbox .gallery-nav { width: 2.5rem; height: 2.5rem; }
			.lightbox .gallery-nav-arrow { border-top-width: 7px; border-bottom-width: 7px; }
			.lightbox .gallery-prev .gallery-nav-arrow { border-right-width: 9px; }
			.lightbox .gallery-next .gallery-nav-arrow { border-left-width: 9px; }
			.lightbox-count {
				position: absolute;
				bottom: clamp(0.75rem, 3vw, 1.5rem);
				left: 50%;
				transform: translateX(-50%);
				font-family: "IBM Plex Mono", monospace;
				font-size: 0.75rem;
				color: #fff;
				background: hsl(0 0% 0% / 0.45);
				padding: 0.25rem 0.7rem;
				border-radius: 2px;
			}

			/* ---------- Última página (contact) ---------- */
			.contact { display: flex; flex-direction: column; gap: 1.5rem; }
			.contact h2 { font-size: clamp(1.9rem, 4vw, 2.6rem); max-width: 20ch; }
			.contact p { color: var(--ink-soft); max-width: 55ch; }
			.contact-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

			footer {
				padding: 1.75rem 0 3rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
				font-family: "IBM Plex Mono", monospace; font-size: 0.75rem; color: var(--ink-faint);
			}

			/* ---------- Vinyl player (easter egg) ---------- */
			.vinyl-widget {
				position: fixed;
				right: clamp(1rem, 3vw, 2rem);
				bottom: clamp(1rem, 3vw, 2rem);
				z-index: 60;
				display: flex;
				align-items: center;
				gap: 0.7rem;
			}

			.vinyl-label {
				font-family: "IBM Plex Mono", monospace;
				font-size: 0.68rem;
				color: var(--ink-faint);
				background: var(--surface-raised);
				border: 1px solid var(--line);
				padding: 0.55rem 0.7rem;
				border-radius: 3px;
				line-height: 1.35;
				width: 12.5rem;
				opacity: 0;
				transform: translateX(6px);
				transition: opacity 0.2s ease, transform 0.2s ease;
				pointer-events: none;
			}
			.vinyl-widget[data-playing="true"] .vinyl-label,
			.vinyl-widget:hover .vinyl-label,
			.vinyl-btn:focus-visible ~ .vinyl-label {
				opacity: 1;
				transform: translateX(0);
				pointer-events: auto;
			}
			.vinyl-label strong { color: var(--ink); display: block; font-size: 0.76rem; }
			.vinyl-artist { display: block; margin-top: 0.1rem; }
			.vinyl-progress {
				margin-top: 0.5rem;
				height: 3px;
				background: var(--line);
				border-radius: 2px;
				overflow: hidden;
			}
			.vinyl-progress-fill {
				height: 100%;
				width: 0%;
				background: var(--accent);
			}
			.vinyl-time {
				display: flex;
				justify-content: space-between;
				margin-top: 0.3rem;
				font-size: 0.62rem;
				color: var(--ink-faint);
				font-variant-numeric: tabular-nums;
			}

			.vinyl-controls {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				margin-top: 0.6rem;
			}
			.vinyl-volume-icon {
				display: flex;
				align-items: center;
				color: var(--ink-faint);
				flex-shrink: 0;
			}
			.vinyl-volume {
				flex: 1;
				accent-color: var(--accent);
				height: 3px;
				cursor: pointer;
			}
			.vinyl-next {
				flex-shrink: 0;
				width: 1.5rem;
				height: 1.5rem;
				border-radius: 50%;
				border: 1px solid var(--line-strong);
				background: var(--surface-raised);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.vinyl-next:hover { border-color: var(--accent); }
			.vinyl-next:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			.icon-next { display: flex; align-items: center; }
			.icon-next-tri {
				width: 0; height: 0;
				border-top: 4px solid transparent;
				border-bottom: 4px solid transparent;
				border-left: 6px solid var(--ink);
			}
			.icon-next-bar { width: 2px; height: 8px; background: var(--ink); margin-left: 1px; }

			.vinyl-btn {
				width: 4.5rem;
				height: 4.5rem;
				border-radius: 50%;
				border: none;
				cursor: pointer;
				position: relative;
				overflow: hidden;
				background: var(--stamp);
				box-shadow: 0 6px 18px hsl(0 40% 4% / 0.35), inset 0 0 0 1px var(--line-strong);
				animation: spin 3.4s linear infinite;
				animation-play-state: paused;
			}
			.vinyl-widget[data-playing="true"] .vinyl-btn { animation-play-state: running; }
			.vinyl-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
			@keyframes spin { to { transform: rotate(360deg); } }

			.vinyl-cover {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 50%;
			}

			.vinyl-icon {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.vinyl-icon-backing {
				position: absolute;
				width: 1.9rem;
				height: 1.9rem;
				border-radius: 50%;
				background: hsl(0 0% 0% / 0.5);
			}
			.icon-play {
				position: relative;
				width: 0; height: 0;
				border-top: 6px solid transparent;
				border-bottom: 6px solid transparent;
				border-left: 9px solid #fff;
				margin-left: 2px;
			}
			.icon-pause { position: relative; display: flex; gap: 3px; }
			.icon-pause span { width: 3px; height: 12px; background: #fff; display: block; }
			.vinyl-widget[data-playing="true"] .icon-play,
			.vinyl-widget:not([data-playing="true"]) .icon-pause { display: none; }
		</style>
